<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LogikBench FPGA Synthesis</title>
<style>
  :root {
    --bg: #0f1115; --panel: #161922; --panel-2: #1c2030; --line: #262b38;
    --txt: #e7e9ee; --txt-dim: #9aa3b2; --accent: #6ea8fe;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--bg); color: var(--txt);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 14px; line-height: 1.45; -webkit-font-smoothing: antialiased;
  }
  .wrap { width: 100%; max-width: 1600px; margin: 0 auto; padding: 28px 22px 60px; }
  header { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: 22px; }
  .brand h1 { font-size: 22px; margin: 0; letter-spacing: -0.01em; }
  .brand h1 .mark { color: var(--accent); }
  .brand p { margin: 4px 0 0; color: var(--txt-dim); font-size: 13px; }
  .flow { display: inline-flex; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 3px; }
  .flow a, .flow span { text-decoration: none; color: var(--txt-dim); font-weight: 600; padding: 7px 16px; border-radius: 7px; }
  .flow .on { background: var(--panel-2); color: var(--txt); box-shadow: 0 1px 0 rgba(255,255,255,.04) inset; }
  .tabs { display: flex; gap: 6px; flex-wrap: wrap; margin: 0 0 14px; }
  .tabs button {
    appearance: none; border: 1px solid var(--line); background: var(--panel); color: var(--txt-dim);
    font: inherit; font-weight: 600; padding: 8px 14px; border-radius: 9px; cursor: pointer; transition: .12s;
  }
  .tabs button:hover { color: var(--txt); border-color: #343b4d; }
  .tabs button.on { background: var(--accent); border-color: var(--accent); color: #08101f; }
  .tabs button .dir { font-weight: 500; opacity: .7; font-size: 12px; }
  .card { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .scroll { overflow: auto; max-height: 72vh; }
  table { border-collapse: separate; border-spacing: 0; width: 100%; }
  th, td { padding: 0; text-align: center; white-space: nowrap; }
  thead th {
    position: sticky; top: 0; z-index: 3; background: var(--panel-2); color: var(--txt);
    font-weight: 600; font-size: 12.5px; padding: 10px 8px 4px;
  }
  thead th.sortable { cursor: pointer; user-select: none; }
  thead th.sortable:hover { color: var(--accent); }
  thead th .arrow { margin-left: 5px; font-size: 10px; opacity: .9; }
  /* two-line target header: vendor on top, part below */
  thead th .t-vendor { display: block; }
  thead th .t-part { display: block; font-weight: 500; font-size: 11.5px; color: var(--txt-dim); }
  /* settings sub-row sits directly under each target name (top set in JS) */
  thead tr.settings th {
    z-index: 3; background: var(--panel-2); border-bottom: 1px solid var(--line);
    font-weight: 500; font-size: 11px; color: var(--txt-dim); padding: 1px 8px 10px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  thead th.bench { text-align: left; z-index: 4; left: 0; padding: 12px 14px; border-bottom: 1px solid var(--line); }
  tbody th.bench {
    position: sticky; left: 0; z-index: 2; background: var(--panel); text-align: left;
    font-weight: 600; padding: 0 14px; border-right: 1px solid var(--line); color: var(--txt);
  }
  tbody td { font-variant-numeric: tabular-nums; font-weight: 600; padding: 10px 8px; border-bottom: 1px solid rgba(255,255,255,.03); }
  tbody tr:last-child td, tbody tr:last-child th { border-bottom: 0; }
  tbody td.empty { color: #5b6373; font-weight: 400; background: transparent !important; }
  .cell-val { color: #0c0f16; text-shadow: 0 1px 0 rgba(255,255,255,.18); }
  tr.grp th { position: sticky; left: 0; background: #11141c; color: var(--txt-dim);
    text-align: left; padding: 7px 16px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; font-weight: 700;
    border-bottom: 1px solid var(--line); z-index: 2; }
  code { background: var(--panel-2); padding: 1px 6px; border-radius: 5px; color: #cdd4e0; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="brand">
      <h1><span class="mark">Logik</span>Bench &mdash; FPGA Synthesis</h1>
    </div>
  </header>

  <div class="tabs" id="tabs"></div>

  <div class="card">
    <div class="scroll">
      <table>
        <thead id="thead"></thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
const SECTION = {{ section_json }};
let metricKey = SECTION.metrics[0].key;
function metric(){ return SECTION.metrics.find(m => m.key === metricKey); }

// Column sort state. sortCol null = grouped default order; otherwise BENCH_COL
// or a target name. Click cycles a column asc -> desc -> default.
const BENCH_COL = "__bench__";
let sortCol = null, sortDir = null;

function cycleSort(col){
  if (sortCol !== col){ sortCol = col; sortDir = "asc"; }
  else if (sortDir === "asc"){ sortDir = "desc"; }
  else { sortCol = null; sortDir = null; }   // 3rd click: back to default
  render();
}

// Sort value for a benchmark in a column (the bench name, or the column's value
// for the selected metric); null when missing so it can be ordered last.
function sortValue(bench, col){
  if (col === BENCH_COL) return bench;
  const r = SECTION.data[bench];
  const v = r && r[col] ? r[col][metricKey] : null;
  return (v === null || v === undefined) ? null : v;
}

function sortedBenches(list){
  if (!sortCol) return list;
  const dir = sortDir === "desc" ? -1 : 1;
  return list.slice().sort((a, b) => {
    const va = sortValue(a, sortCol), vb = sortValue(b, sortCol);
    if (va === null && vb === null) return 0;
    if (va === null) return 1;                 // missing values always last
    if (vb === null) return -1;
    if (typeof va === "string") return dir * va.localeCompare(vb);
    return dir * (va - vb);
  });
}

function cellStyle(hue){ return `background: hsl(${hue.toFixed(0)} 85% 50%);`; }

// "how many times worse than the winner" (>= 1); direction-aware.
function ratioToWinner(v, best, dir){
  if (dir === "lower") return best > 0 ? v / best : (v <= best ? 1 : Infinity);
  return v > 0 ? best / v : Infinity;
}

// Color rule, per row:
//   winner (and exact ties)            -> green  (the only green cell(s))
//   2nd place                          -> yellow (start of the gradient)
//   2nd place .. 10x the winner        -> yellow .. red, LOG in the ratio
//                                         (moderate multiples redden quickly)
//   10x the winner or worse            -> red
// 'second' is the runner-up value (best among the non-winners).
function cellHue(v, best, second, dir){
  if (v === best) return 120;                          // winner(s): green
  const r = ratioToWinner(v, best, dir);
  const rs = ratioToWinner(second, best, dir);         // runner-up ratio (>1)
  if (r >= 10 || !(rs < 10)) return 0;                 // beyond 10x: red
  // log scale anchored at 2nd place (yellow) and 10x (red)
  const frac = (Math.log(r) - Math.log(rs)) / (Math.log(10) - Math.log(rs));
  return 60 * (1 - Math.max(0, Math.min(1, frac)));    // yellow(60) .. red(0)
}

function fmt(v, m){
  if (v === null || v === undefined) return "&mdash;";
  switch (m.unit){
    case "s":    return v.toFixed(2) + "s";
    case "MHz":  return Math.round(v) + " MHz";
    case "ns":   return v.toFixed(2) + " ns";
    case "um^2": return Math.round(v).toLocaleString() + " um^2";
    default:     return Math.round(v).toLocaleString();
  }
}

function renderTabs(){
  const t = document.getElementById("tabs"); t.innerHTML = "";
  SECTION.metrics.forEach(m => {
    const b = document.createElement("button");
    b.className = m.key === metricKey ? "on" : "";
    b.innerHTML = `${m.label} <span class="dir">${m.dir === "lower" ? "&darr; lower better" : "&uarr; higher better"}</span>`;
    b.onclick = () => { metricKey = m.key; render(); };
    t.appendChild(b);
  });
}

// arrow indicator for the column currently sorted by 'col' ("" if not active)
function sortArrow(col){
  if (sortCol !== col) return "";
  return `<span class="arrow">${sortDir === "desc" ? "&darr;" : "&uarr;"}</span>`;
}

// one benchmark row (<tr>); colors are per-row across targets, independent of
// row order, so the same row renders identically grouped or sorted.
function renderRow(bench){
  const targets = SECTION.targets, m = metric();
  const row = SECTION.data[bench] || {};
  const vals = targets.map(t => (row[t] ? row[t][m.key] : null));
  const present = vals.filter(v => v !== null && v !== undefined);
  const best = m.dir === "lower" ? Math.min(...present) : Math.max(...present);
  // runner-up: best value among the non-winners (anchors yellow)
  const losers = present.filter(v => v !== best);
  const second = losers.length
    ? (m.dir === "lower" ? Math.min(...losers) : Math.max(...losers))
    : best;
  let cells = `<th class="bench">${bench}</th>`;
  vals.forEach(v => {
    if (v === null || v === undefined){ cells += `<td class="empty">&mdash;</td>`; return; }
    cells += `<td style="${cellStyle(cellHue(v, best, second, m.dir))}"><span class="cell-val">${fmt(v, m)}</span></td>`;
  });
  const tr = document.createElement("tr"); tr.innerHTML = cells; return tr;
}

function render(){
  renderTabs();
  const targets = SECTION.targets;
  const settings = SECTION.settings || {};
  const labels = SECTION.labels || {};
  const thead = document.getElementById("thead");
  // target column header is "<vendor>_<part>"; show vendor and part on two lines
  const splitTarget = label => {
    const i = label.indexOf("_");
    return i < 0 ? { vendor: label, part: "" }
                 : { vendor: label.slice(0, i), part: label.slice(i + 1) };
  };
  thead.innerHTML =
    `<tr><th class="bench sortable" rowspan="2" data-col="${BENCH_COL}">Benchmark${sortArrow(BENCH_COL)}</th>${targets.map(t => {
      const s = splitTarget(labels[t] || t);
      return `<th class="sortable" data-col="${t}" title="${labels[t] || t}">` +
             `<span class="t-vendor">${s.vendor}${sortArrow(t)}</span>` +
             `<span class="t-part">${s.part || "&nbsp;"}</span></th>`;
    }).join("")}</tr>` +
    `<tr class="settings">${targets.map(t => {
      const s = settings[t] || "";
      return `<th title="${s ? s : "default settings"}">${s ? s : "default"}</th>`;
    }).join("")}</tr>`;
  // stack the settings sub-row flush under the target-name row when sticky
  const nameTh = thead.querySelector("tr:first-child th:not(.bench)");
  if (nameTh){
    const h = nameTh.getBoundingClientRect().height;
    thead.querySelectorAll("tr.settings th").forEach(el => { el.style.position = "sticky"; el.style.top = h + "px"; });
  }
  const tb = document.getElementById("tbody"); tb.innerHTML = "";
  if (sortCol){
    // flat global sort: one ranked list, no group headers
    const all = SECTION.groups.flatMap(g => g.benchmarks);
    sortedBenches(all).forEach(bench => tb.appendChild(renderRow(bench)));
  } else {
    // default: grouped sections in definition order
    SECTION.groups.forEach(group => {
      const gr = document.createElement("tr"); gr.className = "grp";
      gr.innerHTML = `<th colspan="${targets.length + 1}">${group.name}</th>`; tb.appendChild(gr);
      group.benchmarks.forEach(bench => tb.appendChild(renderRow(bench)));
    });
  }
}

// delegated: one listener survives render()'s innerHTML rebuilds
document.getElementById("thead").addEventListener("click", e => {
  const th = e.target.closest("[data-col]"); if (th) cycleSort(th.dataset.col);
});
render();
</script>
</body>
</html>
